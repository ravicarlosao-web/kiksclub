# ─────────────────────────────────────────────
# KicksClub.pt — Exemplo de Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# NUNCA commitar o .env para o Git!
# ─────────────────────────────────────────────

# ── TURSO (Base de Dados LibSQL) ──────────────
# Dashboard: https://turso.tech
TURSO_DATABASE_URL=libsql://kicksclub-kicksclub.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=seu_turso_auth_token_aqui

# ── CLOUDINARY (Armazenamento de Imagens) ──────
# Dashboard: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret

# ── JWT (Autenticação Admin) ───────────────────
# Gerar em: https://generate-secret.vercel.app/64
JWT_SECRET=sua_chave_jwt_super_secreta_minimo_32_caracteres

# ── ADMIN (Primeiro Utilizador) ────────────────
ADMIN_EMAIL=admin@kicksclub.pt
ADMIN_PASSWORD=password_segura_aqui_123!
ADMIN_NAME=Administrador KicksClub

# ── APP ────────────────────────────────────────
VITE_APP_URL=https://kiksclub.vercel.app

# ── STRIPE (Pagamentos: Cartão & MB WAY) ────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...
# Webhook Secret (Dashboard > Developers > Webhooks):
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SEGURANÇA & DIAGNÓSTICO (Opcional) ─────────
# Token secreto para aceder a /api/health (deve ser passado no header x-debug-token)
DEBUG_TOKEN=seu_token_aleatorio_de_diagnostico_aqui

# ── MONITORIZAÇÃO DE ERROS (SENTRY) ────────────
# Obter em: https://sentry.io -> Settings -> Projects -> Client Keys (DSN)
# Backend (Serverless functions Vercel):
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@o000000.ingest.us.sentry.io/0000000
# Frontend (React bundle no browser):
VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxx@o000000.ingest.us.sentry.io/0000000

